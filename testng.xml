<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Default suite" verbose="1">
    <listeners>
        <listener class-name="com.company.automation.listeners.TestListener"/>
        <listener class-name="com.company.automation.listeners.ExtentReportListener"/>
        <listener class-name="com.company.automation.listeners.RetryListener"/>
    </listeners>
    <test name="All tests">
        <packages>
            <package name="com.company.automation.tests.*"/>
        </packages>
    </test>
</suite>
